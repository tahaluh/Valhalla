# Valhalla Environment Variables
# Copy this file to .env and fill in the values

# Session secret - must be at least 32 characters long
SESSION_SECRET="change-this-to-a-very-long-random-secret-string-minimum-32-chars"

# Database URL (SQLite)
DATABASE_URL="file:./data/valhalla.db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Use true somente quando a URL pública usar HTTPS. Em tablets na rede local via HTTP, deixe false.
SESSION_COOKIE_SECURE="false"

# Endpoint oficial usado pelo plugin OBR/Tournamenter para enviar resultados.
OLIMPO_SCORE_API_URL="https://olimpo.robocup.org.br/api/events/steps/score"

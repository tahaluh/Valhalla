// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// SQLite does not support native enums; we use String with validation at the
// application layer via Zod.

// Role: ADMIN | REFEREE | PUBLIC
// CategoryType: RESCUE | ARTISTIC
// ScoreColumnPreset: RESCUE | ARTISTIC

// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id                        String    @id @default(cuid())
  name                      String
  description               String?
  location                  String?
  startDate                 DateTime
  endDate                   DateTime?
  isActive                  Boolean   @default(false)
  adminPassword             String // bcrypt hash
  refereePassword           String // bcrypt hash
  secretariatPassword       String // bcrypt hash
  surpriseChallenge         Boolean   @default(false)
  surpriseChallengeBank     String    @default("[]") // JSON: bancos LEVEL1 e LEVEL2 (legado: array)
  publicRankingMode         String    @default("LIVE") // LIVE | MANUAL
  publicRankingPublishedAt  DateTime?
  resultsStatus             String    @default("PROVISIONAL") // PROVISIONAL | HOMOLOGATED
  resultsHomologatedAt      DateTime?
  olimpoLastSyncAt          DateTime? // última sincronização concluída com sucesso (mesma semântica do plugin)
  olimpoLastSyncAttemptAt   DateTime?
  olimpoLastSyncStatus      String?
  olimpoLastSyncMessage     String?
  olimpoAutoSyncEnabled     Boolean   @default(false)
  olimpoSyncIntervalSeconds Int       @default(600)
  logoUrl                   String?
  rulesUpdateNotice         String?
  activePublicationBatchId  String?
  autoBackupEnabled         Boolean   @default(false)
  backupIntervalMinutes     Int       @default(10)
  rulesValidatedAt          DateTime?
  rulesValidatedBy          String?
  rulesValidationReference  String?
  rulesValidationNotes      String?
  rulesValidationHash       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arenas             Arena[]
  categories         Category[]
  referees           Referee[]
  stations           EvaluationStation[]
  phases             Phase[]
  slots              ScheduleSlot[]
  terminals          Terminal[]
  auditLogs          AuditLog[]
  displayViews       DisplayView[]
  displayScreens     DisplayScreen[]
  appeals            FormalAppeal[]
  publicationBatches PublicationBatch[]
  backupSnapshots    BackupSnapshot[]
  scheduleBlackouts  ScheduleBlackout[]

  @@map("events")
}

// ─── Arena ────────────────────────────────────────────────────────────────────

model Arena {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  // Challenge configuration
  checkpointCount Int    @default(0)
  checkpointTiles String @default("[]") // JSON array of tile counts per checkpoint
  seesaws         Int    @default(0)
  intersections   Int    @default(0)
  obstacles       Int    @default(0)
  ramps           Int    @default(0)
  gaps            Int    @default(0)
  speedBumps      Int    @default(0)
  rulesetName     String @default("OBR Prática Regional 2026")
  rulesetVersion  String @default("2026.1")
  scoringRules    String @default("{}") // JSON snapshot; editable per arena
  difficulty      String @default("MEDIUM") // EASY | MEDIUM | HARD

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores   Score[]
  stations EvaluationStation[]

  @@map("arenas")
}

model ScheduleBlackout {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([eventId, startsAt])
  @@map("schedule_blackouts")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id             String @id @default(cuid())
  name           String
  type           String // "RESCUE" | "ARTISTIC"
  order          Int    @default(0)
  scoringFormula String // JavaScript function source code

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams        Team[]
  scoreColumns ScoreColumn[]
  scores       Score[]

  @@map("categories")
}

// ─── ScoreColumn ──────────────────────────────────────────────────────────────

model ScoreColumn {
  id         String  @id @default(cuid())
  name       String
  order      Int     @default(0)
  isReadOnly Boolean @default(false) // e.g. "Team" and "Final Score" columns

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("score_columns")
}

// ─── Team ─────────────────────────────────────────────────────────────────────

model Team {
  id                  String  @id @default(cuid())
  name                String
  institution         String
  city                String
  state               String
  attendanceConfirmed Boolean @default(false)
  externalSource      String?
  externalId          String?
  externalEventToken  String?
  externalStepId      String?
  externalStepName    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores        Score[]
  scheduleSlots ScheduleSlot[]
  appeals       FormalAppeal[]

  @@map("teams")
}

model EvaluationStation {
  id        String         @id @default(cuid())
  name      String
  type      String // PRACTICE_ARENA | INTERVIEW_TABLE | STAGE | CHALLENGE_TABLE
  order     Int            @default(0)
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  arenaId   String?
  arena     Arena?         @relation(fields: [arenaId], references: [id], onDelete: SetNull)
  slots     ScheduleSlot[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("evaluation_stations")
}

model Phase {
  id                          String         @id @default(cuid())
  name                        String
  type                        String // PRACTICE_ROUND | INTERVIEW | PERFORMANCE | EXTRA_ROUND
  sequence                    Int
  durationSeconds             Int
  calibrationSeconds          Int            @default(0)
  artisticNormalizationFactor Float          @default(1)
  operationalStatus           String         @default("CLOSED") // CLOSED | OPEN | SUSPENDED
  openedAt                    DateTime?
  closedAt                    DateTime?
  eventId                     String
  event                       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots                       ScheduleSlot[]

  @@unique([eventId, sequence])
  @@map("phases")
}

model ScheduleSlot {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phaseId     String
  phase       Phase              @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  stationId   String
  station     EvaluationStation  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  order       Int
  status      String             @default("SCHEDULED")
  session     EvaluationSession?

  @@index([stationId, scheduledAt])
  @@index([teamId, phaseId])
  @@map("schedule_slots")
}

model EvaluationSession {
  id                      String                   @id @default(cuid())
  slotId                  String                   @unique
  slot                    ScheduleSlot             @relation(fields: [slotId], references: [id], onDelete: Cascade)
  state                   String                   @default("SCHEDULED")
  calledAt                DateTime?
  callCount               Int                      @default(0)
  calibrationStartedAt    DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?
  timerAccumulatedSeconds Int                      @default(0)
  scorecard               String                   @default("{}")
  version                 Int                      @default(1)
  operatorName            String?
  announcerName           String?
  scorerName              String?
  draftUpdatedAt          DateTime?
  draftTerminalId         String?
  draftOperatorName       String?
  endedEarly              Boolean                  @default(false)
  endReason               String?
  artisticDecision        String                   @default("NORMAL") // NORMAL | DISQUALIFIED | ORIGINALITY | PROHIBITED_CONTENT
  artisticDecisionReason  String?
  consensusScorecard      String?
  consensusTotal          Float?
  consensusConfirmedAt    DateTime?
  consensusConfirmedBy    String?
  surpriseEligible        Boolean                  @default(true)
  surpriseChallengeText   String?
  surpriseDrawnAt         DateTime?
  surpriseStatus          String                   @default("PENDING") // PENDING | DRAWN | DECLINED | MISSED | DEMONSTRATED | NOT_DEMONSTRATED
  terminalId              String?
  terminal                Terminal?                @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  appeals                 FormalAppeal[]
  draftRevisions          ScorecardDraftRevision[]
  judgeScores             JudgeScore[]

  @@map("evaluation_sessions")
}

model ScorecardDraftRevision {
  id           String            @id @default(cuid())
  sessionId    String
  session      EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version      Int
  scorecard    String
  terminalId   String?
  operatorName String?
  createdAt    DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@map("scorecard_draft_revisions")
}

model JudgeScore {
  id        String            @id @default(cuid())
  sessionId String
  session   EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  judgeName String
  role      String // INTERVIEW | PERFORMANCE
  scorecard String
  total     Float
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, judgeName])
  @@index([sessionId, role])
  @@map("judge_scores")
}

model FormalAppeal {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sessionId   String?
  session     EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  title       String
  description String
  status      String             @default("OPEN") // OPEN | UNDER_REVIEW | ACCEPTED | REJECTED
  decision    String?
  deadlineAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([eventId, status, createdAt])
  @@map("formal_appeals")
}

model Terminal {
  id        String              @id @default(cuid())
  deviceKey String
  name      String
  eventId   String
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions  EvaluationSession[]
  usages    TerminalUsage[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([eventId, deviceKey])
  @@map("terminals")
}

model TerminalUsage {
  id           String    @id @default(cuid())
  terminalId   String
  terminal     Terminal  @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  stationId    String
  operatorName String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@map("terminal_usages")
}

model AuditLog {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action           String
  entityType       String
  entityId         String
  stationId        String?
  teamId           String?
  terminalId       String?
  operatorName     String?
  authorizedByName String?
  actorRole        String?
  before           String?
  after            String?
  reason           String?
  createdAt        DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([stationId, createdAt])
  @@map("audit_logs")
}

model DisplayView {
  id              String         @id @default(cuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  screenId        String?
  screen          DisplayScreen? @relation(fields: [screenId], references: [id], onDelete: SetNull)
  name            String
  type            String // RANKING | SCHEDULE | ANNOUNCEMENT | CALLS
  durationSeconds Int            @default(20)
  order           Int            @default(0)
  enabled         Boolean        @default(true)
  config          String         @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([eventId, order])
  @@index([screenId, order])
  @@map("display_views")
}

model DisplayScreen {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  views     DisplayView[]

  @@unique([eventId, slug])
  @@index([eventId, name])
  @@map("display_screens")
}

model PublicationBatch {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByName  String
  note           String?
  snapshot       String
  restoredFromId String?
  createdAt      DateTime @default(now())

  @@index([eventId, createdAt])
  @@map("publication_batches")
}

model BackupSnapshot {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByName String
  kind          String   @default("MANUAL") // MANUAL | AUTOMATIC
  payload       String
  checksum      String
  createdAt     DateTime @default(now())

  @@index([eventId, createdAt])
  @@map("backup_snapshots")
}

// ─── Score ────────────────────────────────────────────────────────────────────

model Score {
  id          String @id @default(cuid())
  columnIndex Int // which score column this value belongs to
  value       Float
  data        String @default("") // serialized official scorecard sent to Olimpo dataMap
  // Value visible on the public ranking when the event uses manual publication.
  publicValue Float?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  arenaId String?
  arena   Arena?  @relation(fields: [arenaId], references: [id], onDelete: SetNull)

  submittedBy String? // refereeId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ScoreRevision[]

  @@unique([teamId, categoryId, columnIndex])
  @@map("scores")
}

// Every creation or overwrite of a score is retained for admin review.
model ScoreRevision {
  id              String   @id @default(cuid())
  scoreId         String
  score           Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  previousValue   Float?
  nextValue       Float
  previousArenaId String?
  nextArenaId     String?
  changedBy       String
  reason          String?
  createdAt       DateTime @default(now())

  @@index([scoreId, createdAt])
  @@map("score_revisions")
}

// ─── Referee ──────────────────────────────────────────────────────────────────

model Referee {
  id   String @id @default(cuid())
  name String

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("referees")
}
